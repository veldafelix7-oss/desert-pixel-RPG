{
  "name": "desert-pixel-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "test:e2e": "playwright test",
    "test:offline": "playwright test --config playwright.offline.config.js",
    "format": "prettier --write src tests scripts *.js *.json index.html"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.65.0",
    "prettier": "^3.10.1",
    "vite": "^6.4.1"
  }
}
